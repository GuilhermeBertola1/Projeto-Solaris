# =============================================================================
# Modelo das variáveis de ambiente do Projeto Solaris.
#
# 1. Copie este arquivo para ".env" (na mesma pasta).
# 2. Preencha com os seus valores.
#
# O .env está no .gitignore: ele NUNCA vai para o repositório.
# O mesmo .env é lido pelo compose.yaml (banco em container) e pelo Spring Boot.
# =============================================================================

# ---------- Banco de dados ----------
# Senha do administrador do MySQL. Usada só pelo container, nunca pela aplicação.
DB_ROOT_SENHA=

# Usuário que a aplicação usa. O container cria este usuário na primeira subida,
# com permissão apenas sobre o banco "solaris".
DB_USUARIO=solaris_app
DB_SENHA=

# Endereço do banco visto pela aplicação rodando no seu computador.
DB_URL=jdbc:mysql://localhost:3306/solaris

# ---------- Administrador inicial do sistema ----------
# Criado na primeira subida da aplicação, se ainda não existir.
ADMIN_EMAIL=
ADMIN_SENHA=

# ---------- API externa ----------
# Gere a chave em https://perenual.com (a chave antiga do T1 deve ser revogada).
PERENUAL_API_KEY=

# ---------- Modo de execução ----------
# dev  = mensagens de erro com detalhes técnicos
# prod = mensagens de erro sem detalhes técnicos
SPRING_PROFILES_ACTIVE=dev